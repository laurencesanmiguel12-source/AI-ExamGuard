# Copy to frontend/.env before `pnpm dev` (local) or `vite build` (deploy). Both values are baked
# into the build at build time, not read at runtime - a deployed build must be rebuilt (not just
# restarted) if either one changes.

# Local dev default. For a real deploy, point this at the backend's real public URL (the Cloudflare
# Tunnel's domain, e.g. https://api.yourdomain.com) - and when you do, also update backend/.env's
# ALLOWED_ORIGINS and run `python scripts/set_deploy_origin.py <this frontend's real origin>` so the
# Chrome extension stays in sync.
VITE_API_BASE_URL=http://localhost:8000

# The unpacked Chrome extension's ID (chrome://extensions, with Developer Mode on - reload the
# extension after any manifest change and this may change too). Only needs to differ from the
# default below if you're running a different/repackaged copy of extension/.
VITE_EXTENSION_ID=ippkohhninlboeifildoaaehgjpdhgde
