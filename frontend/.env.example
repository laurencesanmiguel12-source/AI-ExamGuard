# Copy to frontend/.env before `pnpm dev` (local) or `vite build` (deploy). Both values are baked
# into the build at build time, not read at runtime - a deployed build must be rebuilt (not just
# restarted) if either one changes.

# Local dev default. For a real deploy, point this at the backend's real public URL (the Cloudflare
# Tunnel's domain, e.g. https://api.yourdomain.com) - and when you do, also update backend/.env's
# ALLOWED_ORIGINS and run `python scripts/set_deploy_origin.py <this frontend's real origin>` so the
# Chrome extension stays in sync.
VITE_API_BASE_URL=http://localhost:8000

# Which extension ID this must be depends on which extension build the frontend is meant to talk
# to - these are two different real IDs, not interchangeable:
#
# - Local dev, testing against an unpacked extension/ load: manifest.json no longer pins a fixed ID
#   (the "key" field that used to do that was removed - Chrome Web Store rejects manifests that
#   have one). Chrome now assigns unpacked installs an ID that isn't guaranteed stable across
#   machines/reloads - check chrome://extensions (Developer Mode on) after "Load unpacked" and use
#   whatever ID is shown there.
#
# - Production, talking to the real published Chrome Web Store extension: the Store assigned its
#   own permanent ID on first publish, shown in the Developer Dashboard listing's URL. Confirmed as
#   of 2026-08-08: gbkbkbcbbehpcoifmkenkjafkfbphmkf - use this value for any deploy build meant to
#   connect to the real published extension.
VITE_EXTENSION_ID=gbkbkbcbbehpcoifmkenkjafkfbphmkf
