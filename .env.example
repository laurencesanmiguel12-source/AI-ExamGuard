# Read automatically by `docker compose` (project-root .env, separate from backend/.env which the
# backend app itself reads). Only needed to override docker-compose.yml's Postgres password default
# ("devpassword") - fine for a throwaway local stack, not fine once the backend is reachable from
# the internet via a Cloudflare Tunnel.
#
# Copy this file to .env (same directory, repo root) and fill in a real password, then
# `docker compose up -d --build` picks it up automatically - no other config needed.
POSTGRES_PASSWORD=replace-with-a-long-random-password
