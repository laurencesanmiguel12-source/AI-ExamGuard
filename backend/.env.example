DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ai_examguard

SECRET_KEY=replace-with-a-long-random-secret-generate-with-python-secrets-token_hex-32

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated, no spaces needed (they're trimmed) - the frontend origin(s) allowed to call this
# API. Defaults to the local Vite dev server if unset. For a deploy, set this to the real frontend
# origin(s), e.g. https://examguard.pages.dev - then also run
# scripts/set_deploy_origin.py <same origin> to keep the Chrome extension in sync.
ALLOWED_ORIGINS=http://localhost:5173
