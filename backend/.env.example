DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ai_examguard

SECRET_KEY=replace-with-a-long-random-secret-generate-with-python-secrets-token_hex-32

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated, no spaces needed (they're trimmed) - the frontend origin(s) allowed to call this
# API. Defaults to the local Vite dev server if unset. For a deploy, set this to the real frontend
# origin(s), e.g. https://examguard.pages.dev - then also run
# scripts/set_deploy_origin.py <same origin> to keep the Chrome extension in sync.
ALLOWED_ORIGINS=http://localhost:5173

# --- Email notifications (entirely optional) ---
# Used only to tell platform admins that a school signed up and is waiting for review, and to tell
# a school when its registration is approved or rejected.
#
# Leave SMTP_HOST empty and NO mail is sent: the app logs what it would have sent and carries on.
# Every notification is best-effort and runs in a background task, so an unreachable or
# misconfigured mail server can never fail a school registration or an approval.
#
# For Gmail you must use an App Password (a Google account with 2FA, then Security -> App
# passwords), NOT your normal account password. Other providers: use whatever SMTP credentials
# they issue. Keep real values in .env only - it is gitignored, unlike this example file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Envelope sender; falls back to SMTP_USERNAME. Most providers reject a From: that is not the
# authenticated account, so usually leave this unset or set it to the same address.
SMTP_FROM=

# Where "a school is waiting for review" alerts go. Comma-separated. Leave empty to send to every
# super_admin account's own email address, which needs no maintenance as operators change.
PLATFORM_NOTIFY_EMAILS=

# Used to build the links inside notification emails ("review it here", "sign in here").
# Set this to the real public frontend origin on a deploy, e.g. https://aiexamguard.com
FRONTEND_BASE_URL=http://localhost:5173
