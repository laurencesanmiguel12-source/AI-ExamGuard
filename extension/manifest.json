{
  "manifest_version": 3,
  "name": "AI-ExamGuard Tab Monitor",
  "version": "0.1.2",
  "description": "Watches for AI-tool/search-engine tab activity during AI-ExamGuard exams and reports it to the exam page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webNavigation"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://google.com/*",
    "*://www.bing.com/*",
    "*://bing.com/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://bard.google.com/*",
    "*://claude.ai/*",
    "*://perplexity.ai/*",
    "*://www.perplexity.ai/*",
    "*://you.com/*",
    "*://poe.com/*",
    "*://copilot.microsoft.com/*",
    "*://meta.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["https://aiexamguard.com/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
