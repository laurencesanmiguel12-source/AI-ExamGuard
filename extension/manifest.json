{
  "manifest_version": 3,
  "name": "AI-ExamGuard Tab Monitor",
  "version": "0.1.0",
  "description": "Watches for AI-tool/search-engine tab activity during AI-ExamGuard exams and reports it to the exam page.",
  "key": "",
  "permissions": ["tabs", "webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost:5173/*"]
  },
  "action": {
    "default_popup": "popup.html"
  }
}
